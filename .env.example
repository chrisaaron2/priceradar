# Copy to .env and fill in. Never commit .env.
# Astro passes this file to the Airflow containers; docker compose reads it too.

# --- eBay Browse API (developer.ebay.com, production keyset) ---
EBAY_APP_ID=
EBAY_CERT_ID=

# --- LLM matching (console.groq.com) ---
GROQ_API_KEY=
# Optional tuning; defaults shown
# MATCHER_MODEL=openai/gpt-oss-120b   (openai/gpt-oss-20b is faster and cheaper)
# MATCHER_MAX_PAIRS=50
# MATCHER_CONFIDENCE_THRESHOLD=0.6

# --- AWS S3 raw archive (optional) ---
# Leave S3_BUCKET_NAME empty to skip S3: raw JSON is not archived and Spark writes its
# Parquet to output/ instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=

# --- Postgres staging database (docker compose service) ---
# Scripts on your machine: localhost. Airflow tasks under `astro dev start`: host.docker.internal
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=priceradar
POSTGRES_USER=priceradar
POSTGRES_PASSWORD=priceradar_dev

# --- BigQuery warehouse ---
GCP_PROJECT_ID=
BQ_DATASET=priceradar_warehouse
# Save your service-account key (BigQuery Data Editor + BigQuery Job User) as
# include/gcp-key.json. It is git-ignored, and every part of the project finds it there,
# so GOOGLE_APPLICATION_CREDENTIALS only needs setting if you keep the key elsewhere.
# GOOGLE_APPLICATION_CREDENTIALS=

# --- API ---
# Leave empty for local development; set to require an X-API-Key header.
API_KEY=
ALLOWED_ORIGINS=*

# --- Airflow / MLflow ---
AIRFLOW__CORE__LOAD_EXAMPLES=False
MLFLOW_TRACKING_URI=http://localhost:5000
